# Database (PostgreSQL / Neon compatible)
DATABASE_URL=postgresql://username:password@localhost:5432/tripwise?schema=public

# Backend Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Authentication Security
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars

# Google AI (Gemini)
GEMINI_API_KEY=

# Google OAuth (Optional / Future expansion)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# External Services (Optional - app gracefully handles unconfigured state)
GOOGLE_MAPS_API_KEY=
WEATHER_API_KEY=
